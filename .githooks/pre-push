#!/bin/sh
# Pre-push hook for ephor (open-source-bound).
# 1. Secret pattern scan of pushed commits
# 2. Quality gate and version consistency on main pushes
# 3. Version consistency on new tag pushes (re-pushes of existing tags skip)
# 4. Block personal dev files (.opencode/, opencode.json)

fail=0
zero_sha="0000000000000000000000000000000000000000"

# Secret patterns for the added-lines scan (EPH-I0948). The quote classes
# carry a literal apostrophe: the \x27 hex escape is not portable to BSD
# ERE, where it reads as literal x, 2, 7 and corrupts the negated password
# value class.
secret_re='BEGIN (RSA|EC|OPENSSH|PGP|DSA) PRIVATE KEY|api[_-]?key["'\'']?\s*[:=]\s*["'\''][A-Za-z0-9_/-]{16,}|secret["'\'']?\s*[:=]\s*["'\''][A-Za-z0-9_/-]{16,}|password["'\'']?\s*[:=]\s*["'\''][^"'\'']{8,}|ghp_[A-Za-z0-9]{36}|glpat-[A-Za-z0-9_-]{20}|sk-[A-Za-z0-9]{32,}'

while read local_ref local_sha remote_ref remote_sha; do
    # Compute the pushed delta for the scans (EPH-I0947). The delta exists
    # only when the old remote commit resolves locally. A new ref (remote
    # sha is all zeros) has no old commit, and a rewritten history pushed
    # without a prior fetch prunes the old commit; both shapes skip the
    # scans and print a manual-review NOTE instead.
    range=""
    if [ "$remote_sha" != "$zero_sha" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="${remote_sha}..${local_sha}"
    fi

    if [ -n "$range" ]; then
        # 1. Secret pattern scan (added lines only)
        secrets=$(git diff "$range" 2>/dev/null | grep '^+' | grep -iE "$secret_re" | head -5)
        if [ -n "$secrets" ]; then
            echo "PUSH BLOCKED: possible secret in pushed changes:"
            echo "$secrets"
            fail=1
        fi

        # 4. Personal dev files must never be pushed (additions only —
        # removal commits must pass)
        bad_files=$(git diff --name-only --diff-filter=A "$range" 2>/dev/null | grep -E '^\.opencode/|^opencode\.json$|^AGENTS\.md$' | head -5)
        if [ -n "$bad_files" ]; then
            echo "PUSH BLOCKED: personal dev files must not be tracked: $bad_files"
            fail=1
        fi
    else
        echo "NOTE: the pushed delta for ${remote_ref} cannot be computed."
        if [ "$remote_sha" = "$zero_sha" ]; then
            echo "      The ref is new, so no old commit exists to diff against."
        else
            echo "      The old commit ${remote_sha} does not resolve locally."
        fi
        echo "      Review the pushed commits manually before this push."
    fi

    # 2. Quality gate on pushes to main (fmt + build + test) plus version
    # consistency (EPH-I0655, REL-RELEASE-6): the post-tag fallback refresh
    # lands on a main push, and a fallback that names a tag the remote does
    # not have must not ship. check-version.sh sections 3/5/6 skip when the
    # tags API is unreachable, so an offline push still passes.
    case "$local_ref" in
        refs/heads/main)
            echo "Running pre-push quality gate..."
            if ! zig fmt --check src/ 2>/dev/null; then
                echo "PUSH BLOCKED: zig fmt --check failed (run zig fmt src/)"
                fail=1
            fi
            if ! zig build -Doptimize=ReleaseSafe 2>/dev/null; then
                echo "PUSH BLOCKED: build failed"
                fail=1
            fi
            if ! zig build test 2>/dev/null; then
                echo "PUSH BLOCKED: zig build test failed"
                fail=1
            fi
            if [ -f scripts/check-version.sh ]; then
                if ! ./scripts/check-version.sh; then
                    echo "PUSH BLOCKED: version mismatch"
                    fail=1
                fi
            fi
            ;;
    esac

    # 3. Version consistency on NEW tag pushes. Re-pushing a tag that already
    # exists on the remote (a rewritten history, EPH-I0930) can never match
    # the working-tree version, so the comparison would block the re-push
    # forever. The secret and personal-file scans above cover the pushed
    # delta only when the old tag commit resolves locally. After a history
    # rewrite (git filter-repo) the old commit is pruned, the diff yields
    # nothing, and the hook prints a manual-review NOTE instead.
    case "$local_ref" in
        refs/tags/v*)
            TAG_VERSION=$(echo "$local_ref" | sed 's|refs/tags/v||')
            if [ "$remote_sha" = "$zero_sha" ]; then
                echo "Checking version consistency for tag v${TAG_VERSION}..."
                if [ -f scripts/check-version.sh ]; then
                    if ! ./scripts/check-version.sh "$TAG_VERSION"; then
                        echo "PUSH BLOCKED: version mismatch"
                        fail=1
                    fi
                fi
            else
                if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
                    echo "Re-pushing existing tag v${TAG_VERSION}: version check skipped"
                else
                    echo "NOTE: the pushed delta for tag v${TAG_VERSION} cannot be computed."
                    echo "      The old tag commit ${remote_sha} does not resolve locally."
                    echo "      Review the pushed commits manually before this push."
                fi
            fi
            ;;
    esac
done

[ $fail -ne 0 ] && exit 1
exit 0
